# Copy to a root-owned path outside the repository (for example
# /etc/sigdesk/beta.env), chmod 600, and replace every CHANGE_ME.
COMPOSE_PROJECT_NAME=sigdesk-beta
SIGDESK_HOSTNAME=beta-desk.sig.systems
BETA_BIND_ADDRESS=0.0.0.0
BETA_HTTPS_PORT=443
BETA_TLS_CERT_FILE=/etc/sigdesk/tls/fullchain.pem
BETA_TLS_KEY_FILE=/etc/sigdesk/tls/privkey.pem

# Corporate SIGTools. Browser calls are proxied through /sigtools.
SIGTOOLS_UPSTREAM=https://api.sig.systems:8091
SIGTOOLS_TLS_NAME=api.sig.systems
SIGTOOLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
SIGTOOLS_API_URL=https://api.sig.systems:8091
SIGTOOLS_ASSETS_API_URL=https://api.sig.systems:8091
SIGTOOLS_ASSETS_READ_TOKEN=CHANGE_ME

# Immutable application images. CI should replace CHANGE_ME with real digests.
SIGDESK_FRONTEND_IMAGE=registry.example.invalid/sigdesk/frontend@sha256:CHANGE_ME
SIGDESK_ORGANIZATION_IMAGE=registry.example.invalid/sigdesk/organization@sha256:CHANGE_ME
SIGDESK_RESOURCE_IMAGE=registry.example.invalid/sigdesk/resource@sha256:CHANGE_ME
SIGDESK_TICKETS_IMAGE=registry.example.invalid/sigdesk/tickets@sha256:CHANGE_ME
SIGDESK_CHANGE_IMAGE=registry.example.invalid/sigdesk/change@sha256:CHANGE_ME
SIGDESK_PROBLEM_IMAGE=registry.example.invalid/sigdesk/problem@sha256:CHANGE_ME
SIGDESK_WORKFLOW_IMAGE=registry.example.invalid/sigdesk/workflow@sha256:CHANGE_ME
SIGDESK_NOTIFICATION_IMAGE=registry.example.invalid/sigdesk/notification@sha256:CHANGE_ME
SIGDESK_AUDIT_IMAGE=registry.example.invalid/sigdesk/audit@sha256:CHANGE_ME
SIGDESK_KNOWLEDGE_IMAGE=registry.example.invalid/sigdesk/knowledge@sha256:CHANGE_ME
SIGDESK_RAG_IMAGE=registry.example.invalid/sigdesk/rag@sha256:CHANGE_ME
SIGDESK_AI_ADVISOR_IMAGE=registry.example.invalid/sigdesk/ai-advisor@sha256:CHANGE_ME
SIGDESK_KONG_IMAGE=kong@sha256:CHANGE_ME

# Immutable infrastructure images.
BETA_POSTGRES_IMAGE=pgvector/pgvector@sha256:CHANGE_ME
BETA_KAFKA_IMAGE=confluentinc/cp-kafka@sha256:CHANGE_ME
BETA_TEMPORAL_IMAGE=temporalio/auto-setup@sha256:CHANGE_ME
BETA_OBJECT_STORAGE_IMAGE=rustfs/rustfs@sha256:CHANGE_ME
BETA_OBJECT_STORAGE_CLIENT_IMAGE=rustfs/rc@sha256:CHANGE_ME
BETA_EDGE_IMAGE=nginx@sha256:CHANGE_ME
BETA_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:CHANGE_ME
BETA_RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:CHANGE_ME
BETA_OLLAMA_IMAGE=ollama/ollama@sha256:CHANGE_ME

# Shared signing and internal service credentials. Use independent random
# values of at least 32 bytes, encoded as hex or base64url.
JWT_SECRET=CHANGE_ME
ORGANIZATION_INTERNAL_SECRET=CHANGE_ME
RESOURCE_INTERNAL_SECRET=CHANGE_ME
TICKETS_INTERNAL_SECRET=CHANGE_ME
CHANGE_INTERNAL_SECRET=CHANGE_ME

# PostgreSQL administrator and one role/password per bounded context.
POSTGRES_ADMIN_USER=sigdesk_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
ORGANIZATION_DB_PASSWORD=CHANGE_ME
RESOURCE_DB_PASSWORD=CHANGE_ME
TICKETS_DB_PASSWORD=CHANGE_ME
CHANGE_DB_PASSWORD=CHANGE_ME
PROBLEM_DB_PASSWORD=CHANGE_ME
WORKFLOW_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME
KNOWLEDGE_DB_PASSWORD=CHANGE_ME
RAG_DB_PASSWORD=CHANGE_ME
AI_ADVISOR_DB_PASSWORD=CHANGE_ME
TEMPORAL_DB_PASSWORD=CHANGE_ME

# Values required by compose.prod.yaml before its beta overrides are merged.
ORGANIZATION_DATABASE_URL=postgres://organization_service:${ORGANIZATION_DB_PASSWORD}@postgres:5432/sigdesk_organization_beta
RESOURCE_DATABASE_URL=postgres://resource_service:${RESOURCE_DB_PASSWORD}@postgres:5432/sigdesk_resource_beta
TICKETS_DATABASE_URL=postgres://tickets_service:${TICKETS_DB_PASSWORD}@postgres:5432/sigdesk_tickets_beta
CHANGE_DATABASE_URL=postgres://change_service:${CHANGE_DB_PASSWORD}@postgres:5432/sigdesk_change_beta
PROBLEM_DATABASE_URL=postgres://problem_service:${PROBLEM_DB_PASSWORD}@postgres:5432/sigdesk_problem_beta
WORKFLOW_DATABASE_URL=postgres://workflow_service:${WORKFLOW_DB_PASSWORD}@postgres:5432/sigdesk_workflow_beta
NOTIFICATION_DATABASE_URL=postgres://notification_service:${NOTIFICATION_DB_PASSWORD}@postgres:5432/sigdesk_notification_beta
AUDIT_DATABASE_URL=postgres://audit_service:${AUDIT_DB_PASSWORD}@postgres:5432/sigdesk_audit_beta
KNOWLEDGE_DATABASE_URL=postgres://knowledge_service:${KNOWLEDGE_DB_PASSWORD}@postgres:5432/sigdesk_knowledge_beta
RAG_DATABASE_URL=postgres://rag_service:${RAG_DB_PASSWORD}@postgres:5432/sigdesk_rag_beta
AI_ADVISOR_DATABASE_URL=postgres://ai_advisor_service:${AI_ADVISOR_DB_PASSWORD}@postgres:5432/sigdesk_ai_advisor_beta
KAFKA_BROKERS=kafka:29092
KAFKA_CLUSTER_ID=CHANGE_ME
INVENTORY_API_URL=https://api.sig.systems:8091
INVENTORY_SERVICE_TOKEN=${SIGTOOLS_ASSETS_READ_TOKEN}

# Base Compose requires these paths even though beta disables Temporal TLS and
# Kong terminates no public TLS. Point them at existing non-secret certificate
# files; the public edge certificate remains the only externally used key.
KONG_TLS_CERT_FILE=/etc/sigdesk/tls/fullchain.pem
KONG_TLS_KEY_FILE=/etc/sigdesk/tls/privkey.pem
TEMPORAL_TLS_CA_FILE=/etc/sigdesk/tls/fullchain.pem
TEMPORAL_TLS_CERT_FILE=/etc/sigdesk/tls/fullchain.pem
TEMPORAL_TLS_KEY_FILE=/etc/sigdesk/tls/privkey.pem
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_SERVER_NAME=temporal

# Microsoft Graph notification channel. Use a beta sender/mailbox.
MICROSOFT_TENANT_ID=CHANGE_ME
MICROSOFT_CLIENT_ID=CHANGE_ME
MICROSOFT_CLIENT_SECRET=CHANGE_ME
MICROSOFT_SENDER=CHANGE_ME

# S3-compatible object storage.
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
KNOWLEDGE_S3_ENDPOINT=http://object_storage:9000
KNOWLEDGE_S3_BUCKET=sigdesk-kb-beta
KNOWLEDGE_S3_ACCESS_KEY=${OBJECT_STORAGE_ACCESS_KEY}
KNOWLEDGE_S3_SECRET_KEY=${OBJECT_STORAGE_SECRET_KEY}
KNOWLEDGE_S3_REGION=us-east-1
RAG_S3_ACCESS_KEY=CHANGE_ME
RAG_S3_SECRET_KEY=CHANGE_ME

# AI endpoints. These can be approved remote endpoints. For -LocalAI use the
# internal values shown here and provision enough memory.
TEI_URL=http://tei:80
RERANKER_URL=http://reranker:80
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=local-ollama-no-key
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://CHANGE_ME/v1/traces
TEI_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
OLLAMA_MODEL=qwen3:4b-instruct
