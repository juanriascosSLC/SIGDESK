map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8443 ssl http2;
    server_name ${SIGDESK_HOSTNAME};
    server_tokens off;

    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ready\n";
    }

    location /sigdesk-api/ {
        rewrite ^/sigdesk-api(/.*)$ $1 break;
        proxy_pass http://kong:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location /sigtools/ {
        rewrite ^/sigtools(/.*)$ $1 break;
        proxy_pass ${SIGTOOLS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${SIGTOOLS_TLS_NAME};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin ${SIGTOOLS_UPSTREAM};
        proxy_set_header Referer ${SIGTOOLS_UPSTREAM}/;
        proxy_ssl_server_name on;
        proxy_ssl_name ${SIGTOOLS_TLS_NAME};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/sigtools-ca.pem;
        proxy_ssl_verify_depth 4;
        proxy_cookie_domain ${SIGTOOLS_TLS_NAME} $host;
        proxy_cookie_path / /;
        proxy_cookie_flags ~ secure samesite=lax;
        proxy_redirect ${SIGTOOLS_UPSTREAM}/ /sigtools/;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
