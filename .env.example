# Environment Mode (development | production)
APP_ENV=development

# Server Port
PORT=8080

# CORS Allowed Origins
FRONTEND_ORIGIN=http://localhost:3003,http://localhost:5173,http://localhost:5199,http://localhost:80,http://web:80

# Database Connection URL
DATABASE_URL=postgres://sigdesk:sigdesk@localhost:5432/sigdesk?sslmode=disable

# Attachments Storage Directory
ATTACHMENTS_DIR=./data/attachments

# SIGTools Authentication API Service URL (ADR-0007)
# Leave empty ONLY for self-contained local development (disables auth).
# Required when APP_ENV=production.
SIGTOOLS_API_URL=

# Bootstrap Administrators (comma-separated SIGTools usernames)
SIGDESK_BOOTSTRAP_ADMINS=
