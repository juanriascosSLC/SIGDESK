erDiagram

%% ==================== ORGANIZATION ====================
COMPANIES {
    int id PK
    string nombre
    string tipo "empresa | departamento | equipo"
    int parent_id FK "auto-referencia: jerarquia"
}

ROLES {
    int id PK
    string nombre
    string descripcion
}

PERMISOS {
    int id PK
    int role_id FK
    string entidad
    string accion "create | read | update | delete"
    string alcance "propio | equipo | depto | global"
}

USUARIOS {
    int id PK
    string nombre
    string email
    int company_id FK
    int role_id FK
    string estado "activo | inactivo"
}

AGENTES {
    int id PK
    int usuario_id FK "1:1 con USUARIOS"
    string especialidad_categoria
    int capacidad_carga
}

%% ==================== RESOURCE MANAGEMENT ====================
RECURSOS {
    int id PK
    string nombre
    string tipo "hardware | software | red"
    string estado "adquisicion | en_uso | mantenimiento | baja"
    date fecha_alta
}

HARDWARE {
    int recurso_id PK_FK
    string ubicacion_fisica
    date garantia_hasta
    int usuario_asignado_id FK
}

SOFTWARE_LICENCIAS {
    int recurso_id PK_FK
    date fecha_vencimiento
    int seats_totales
    int seats_usados
}

INFRAESTRUCTURA_RED {
    int recurso_id PK_FK
    string estado_disponibilidad
    string topologia
}

RECURSO_COMPANY {
    int recurso_id FK
    int company_id FK
}

RECURSO_RESPONSABLES {
    int recurso_id FK
    int usuario_id FK "manager del recurso"
}

%% ==================== TICKETS ====================
CATEGORIAS_TICKET {
    int id PK
    string nombre
}

TICKETS {
    int id PK
    string titulo
    string descripcion
    int recurso_id FK "obligatorio"
    int creador_id FK
    int categoria_id FK
    string estado_lifecycle "abierto|en_progreso|resuelto|cerrado|reabierto"
    datetime fecha_creacion
}

TICKET_ASIGNACION {
    int id PK
    int ticket_id FK
    int agente_id FK "1er responsable"
    string tipo_asignacion "automatica | manual"
    boolean vigente
    datetime fecha_asignacion
}

TICKET_ASIGNACION_IT {
    int id PK
    int ticket_id FK
    int agente_id FK "especialista IT"
    datetime fecha_asignacion
}

TICKET_DESTINATARIOS {
    int ticket_id FK
    int usuario_id FK "a quien se notifica, no resuelve"
}

TICKET_SLA {
    int id PK
    int ticket_id FK
    datetime tiempo_limite
    datetime fecha_incumplimiento
    string estado "cumplido | incumplido | en_curso"
}

TICKET_HISTORIAL {
    int id PK
    int ticket_id FK
    string campo_modificado
    string valor_anterior
    string valor_nuevo
    datetime fecha
}

%% ==================== WORKFLOWS ====================
WORKFLOWS {
    int id PK
    int categoria_id FK
    string nombre
    string estado "borrador | publicado"
    int version
}

WORKFLOW_REGLAS {
    int id PK
    int workflow_id FK
    string condicion
    string accion
}

%% ==================== NOTIFICACIONES ====================
PLANTILLAS_NOTIFICACION {
    int id PK
    string evento
    string canal
    string contenido
}

NOTIFICACIONES {
    int id PK
    int ticket_id FK "nullable"
    int recurso_id FK "nullable"
    int plantilla_id FK
    string canal
    datetime fecha_envio
    string estado_envio
}

PREFERENCIAS_CANAL_USUARIO {
    int id PK
    int usuario_id FK
    string canal_preferido
}

%% ==================== AGENTE DE IA ====================
AGENTE_IA_SUGERENCIAS {
    int id PK
    int ticket_id FK
    string tipo_sugerencia "triage | copiloto | chatbot"
    string contenido_sugerido
    boolean aceptada
    datetime fecha
}

%% ==================== AUDITORIA ====================
LOG_AUDITORIA {
    int id PK
    int usuario_id FK "quien ejecuto"
    string entidad_afectada
    string accion "create | read | update | delete"
    string valor_anterior
    string valor_nuevo
    datetime fecha
}

%% ==================== RELACIONES ====================
COMPANIES ||--o{ COMPANIES : "es padre de (jerarquia)"
COMPANIES ||--o{ USUARIOS : "pertenece a"
ROLES ||--o{ USUARIOS : "tiene"
ROLES ||--o{ PERMISOS : "define"
USUARIOS ||--o| AGENTES : "es"

RECURSOS ||--o| HARDWARE : "es"
RECURSOS ||--o| SOFTWARE_LICENCIAS : "es"
RECURSOS ||--o| INFRAESTRUCTURA_RED : "es"
RECURSOS ||--o{ RECURSO_COMPANY : "compartido via"
COMPANIES ||--o{ RECURSO_COMPANY : "comparte"
RECURSOS ||--o{ RECURSO_RESPONSABLES : "tiene"
USUARIOS ||--o{ RECURSO_RESPONSABLES : "es responsable de"
USUARIOS ||--o{ HARDWARE : "usuario asignado"

CATEGORIAS_TICKET ||--o{ TICKETS : "clasifica"
RECURSOS ||--o{ TICKETS : "referenciado por (obligatorio)"
USUARIOS ||--o{ TICKETS : "crea"
TICKETS ||--o{ TICKET_ASIGNACION : "historial de asignacion"
AGENTES ||--o{ TICKET_ASIGNACION : "asignado en"
TICKETS ||--o{ TICKET_ASIGNACION_IT : "puede escalar a"
AGENTES ||--o{ TICKET_ASIGNACION_IT : "asignado en"
TICKETS ||--o{ TICKET_DESTINATARIOS : "notifica a"
USUARIOS ||--o{ TICKET_DESTINATARIOS : "recibe notificacion de"
TICKETS ||--|| TICKET_SLA : "tiene"
TICKETS ||--o{ TICKET_HISTORIAL : "genera"

CATEGORIAS_TICKET ||--o{ WORKFLOWS : "define reglas para"
WORKFLOWS ||--o{ WORKFLOW_REGLAS : "contiene"

PLANTILLAS_NOTIFICACION ||--o{ NOTIFICACIONES : "usa"
TICKETS ||--o{ NOTIFICACIONES : "genera"
RECURSOS ||--o{ NOTIFICACIONES : "genera"
USUARIOS ||--o{ PREFERENCIAS_CANAL_USUARIO : "define"

TICKETS ||--o{ AGENTE_IA_SUGERENCIAS : "recibe sugerencia sobre"

USUARIOS ||--o{ LOG_AUDITORIA : "ejecuta accion registrada en"
