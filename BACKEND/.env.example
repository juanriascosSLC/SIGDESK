APP_ENV=development
PORT=8080
# Comma-separated list of browser origins allowed to call this API. A single
# value silently blocks the others, and the failure only appears in the browser
# console — never in the API logs.
FRONTEND_ORIGIN=http://localhost:3003,http://localhost:5173,http://localhost:5199

# Leave empty to use the in-memory development repository.
DATABASE_URL=postgres://sigdesk:sigdesk@localhost:5432/sigdesk?sslmode=disable

# Where ticket attachments are stored on disk.
ATTACHMENTS_DIR=./data/attachments

# ─── Authentication ──────────────────────────────────────────────────────────
# SIGTools is the company-wide auth service shared with SIGInstallations and
# SIGInventory: Active Directory credentials, one session across all three
# apps. The API validates every caller against its /web-auth/me/ endpoint.
#
# Leaving this empty DISABLES authentication and permission checks — allowed
# for local development only. With APP_ENV=production the process refuses to
# start without it.
SIGTOOLS_API_URL=http://api.sig.systems:8091

# ─── Authorization ───────────────────────────────────────────────────────────
# Roles and permissions are SIG-DESK's own and live in its PostgreSQL database
# (see ADR-0008) — they are NOT the shared platform's roles.
#
# Comma-separated SIGTools usernames that always resolve as administrators.
# Required to bootstrap a fresh install: without at least one, nobody can reach
# role administration and there is no way to grant the first role.
SIGDESK_BOOTSTRAP_ADMINS=
