# API propia de SIG-DESK — detrás de Kong Gateway (ADR-0016/RIG-01), no
# contra un microservicio directo. kong.yml expone rutas bare (/me, /admin,
# /tickets, /roles, /usuarios, ...) sin prefijo /api ni /v1 — ese
# versionado es RIG-02, todavía pendiente — así que esta URL NO lleva
# /api/v1. El proxy de Kong en desarrollo escucha en el puerto 8000
# (compose.override.yaml), no en el 8080 de tickets_service.
VITE_API_URL=http://localhost:8000

# SIGTools — the company-wide auth service shared with SIGInstallations and
# SIGInventory. Handles login/logout/me and the roles & permissions registry.
# Credentials are Active Directory domain accounts.
#   Producción / red de oficina:
VITE_SIGTOOLS_API_URL=http://api.sig.systems:8091
#   SIGTools local:
# VITE_SIGTOOLS_API_URL=http://localhost:8000
#   Servidor en la LAN:
# VITE_SIGTOOLS_API_URL=http://192.168.101.135:8000
#
# The frontend's origin must be listed in the backend's CORS_ALLOWED_ORIGINS.
# http://localhost:<port> is already covered by its regex, so the dev server
# works with no backend change.
